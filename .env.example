# Core
APP_NAME=SafeSphere
ENVIRONMENT=development
SECRET_KEY=dev-local-secret-key-change-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite for easy Windows/local development)
DATABASE_URL=sqlite:///./backend/disaster.db

# Bootstrap first administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
BOOTSTRAP_ADMIN_NAME=System Administrator

# Public providers
WEATHER_PROVIDER=open_meteo
OSRM_BASE_URL=https://router.project-osrm.org
ENABLE_EXTERNAL_ROUTING=false

# SMS provider: disabled | msg91 | twilio
SMS_PROVIDER=disabled
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional grounded AI assistant (OpenAI-compatible endpoint)
AI_ENABLED=false
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=meta/llama-3.3-70b-instruct

# Optional satellite provider credentials
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=15
